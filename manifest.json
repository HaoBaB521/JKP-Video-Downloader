{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "__MSG_manifest_name__",
  "description": "__MSG_manifest_description__",
  "version": "2.1",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png",
    "256": "icon/256.png"
  },
  "default_locale": "zh_CN",
  "permissions": [
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.snssdk.com/*",
    "https://*.douyinpic.com/*",
    "https://*.amemv.com/*",
    "https://*.douyinstatic.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.ixigua.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "resources": [
        "*.svg",
        "fetcher.js",
        "*.js.map"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "128": "icon/128.png"
    }
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "css": [
        "content-scripts/content.css"
      ],
      "js": [
        "content-scripts/content.js"
      ]
    }
  ]
}